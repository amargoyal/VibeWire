{
  "name": "vibewire-web",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "description": "VibeWire web client \u2014 the same instrument as the iPhone app, in a browser.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "dev:dashboard": "vite --config vite.dashboard.config.ts",
    "build:dashboard": "tsc --noEmit -p tsconfig.dashboard.json && vite build --config vite.dashboard.config.ts",
    "build:all": "npm run build && npm run build:dashboard"
  },
  "dependencies": {
    "@noble/ed25519": "^2.1.0",
    "@preact/signals": "^2.0.1",
    "preact": "^10.25.4"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  }
}
